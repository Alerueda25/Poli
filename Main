// Define el paquete donde se encuentra esta clase
package aleja;

// Importa las clases necesarias para manejar archivos y colecciones
import java.io.*;
import java.util.*;

// Clase principal del programa que lee los archivos generados y calcula las ventas
public class Main {

    public static void main(String[] args) {
        // Definimos la ruta de los archivos dentro del proyecto (normalmente están en src/)
        String rutaVendedores = "src/vendedores.txt"; // Archivo de datos de los vendedores
        String rutaProductos = "src/productos.txt";   // Archivo de datos de los productos
        String rutaVentas = "src/Juan Pérez_123456789_ventas.txt"; // Archivo de ventas para un vendedor específico

        try {
            // Carga los vendedores desde el archivo y los guarda en un mapa (clave = número documento)
            Map<String, Vendedor> vendedores = leerVendedores(rutaVendedores);

            // Carga los productos desde el archivo y los guarda en un mapa (clave = ID producto)
            Map<String, Producto> productos = leerProductos(rutaProductos);

            // Procesa el archivo de ventas usando los datos cargados
            procesarVentas(rutaVentas, vendedores, productos);

            // Imprime por consola las ventas totales por vendedor
            for (Vendedor vendedor : vendedores.values()) {
                System.out.println(vendedor);
            }

            // Genera un archivo CSV con los resultados de ventas por vendedor
            generarReporteCSV(vendedores, "reporte_ventas.csv");

        } catch (IOException e) {
            // Muestra mensaje si ocurre un error al trabajar con archivos
            System.err.println("Error al leer los archivos: " + e.getMessage());
        }
    }

    // Lee los vendedores desde un archivo y los retorna en un mapa
    public static Map<String, Vendedor> leerVendedores(String archivoVendedores) throws IOException {
        try (BufferedReader reader = new BufferedReader(new FileReader(archivoVendedores))) {
            Map<String, Vendedor> vendedores = new HashMap<>();
            String line;

            // Lee cada línea del archivo de vendedores
            while ((line = reader.readLine()) != null) {
                // Divide la línea usando punto y coma como separador
                String[] datos = line.split(";");
                String tipoDoc = datos[0];
                String numeroDoc = datos[1];
                String nombre = datos[2];
                String apellido = datos[3];

                // Crea un objeto Vendedor con los datos leídos
                Vendedor vendedor = new Vendedor(tipoDoc, numeroDoc, nombre, apellido);

                // Lo guarda en el mapa, usando el número de documento como clave
                vendedores.put(numeroDoc, vendedor);
            }

            return vendedores;
        }
    }

    // Lee los productos desde un archivo y los retorna en un mapa
    public static Map<String, Producto> leerProductos(String archivoProductos) throws IOException {
        try (BufferedReader reader = new BufferedReader(new FileReader(archivoProductos))) {
            Map<String, Producto> productos = new HashMap<>();
            String line;

            // Lee cada línea del archivo de productos
            while ((line = reader.readLine()) != null) {
                String[] datos = line.split(";");
                String idProducto = datos[0];
                String nombreProducto = datos[1];
                // Reemplaza la coma por punto en el precio si es necesario y lo convierte a double
                double precioProducto = Double.parseDouble(datos[2].replace(",", "."));

                // Crea el objeto producto
                Producto producto = new Producto(idProducto, nombreProducto, precioProducto);

                // Lo guarda en el mapa usando el ID como clave
                productos.put(idProducto, producto);
            }

            return productos;
        }
    }

    // Procesa las ventas y suma los valores a los vendedores
    public static void procesarVentas(String archivoVentas, Map<String, Vendedor> vendedores, Map<String, Producto> productos) throws IOException {
        try (BufferedReader reader = new BufferedReader(new FileReader(archivoVentas))) {
            String line;

            // Lee la primera línea que contiene la información del vendedor
            line = reader.readLine();
            if (line != null) {
                String[] datosVendedor = line.split(";");
                if (datosVendedor.length >= 2) {
                    String vendedorId = datosVendedor[1].trim(); // Se extrae el número de documento
                    Vendedor vendedor = vendedores.get(vendedorId); // Se busca el vendedor en el mapa

                    if (vendedor == null) {
                        System.out.println("Vendedor no encontrado: " + vendedorId);
                        return;
                    }

                    // Procesa el resto de líneas que contienen ventas
                    while ((line = reader.readLine()) != null) {
                        String[] datosVenta = line.split(";");
                        if (datosVenta.length < 2) continue;

                        String idProducto = datosVenta[0].trim();
                        int cantidadVendida = Integer.parseInt(datosVenta[1].trim());

                        // Corrige el formato del ID si está incompleto
                        if (idProducto.length() == 2) {
                            idProducto = "P00" + idProducto.charAt(1);
                        } else if (idProducto.length() == 3) {
                            idProducto = "P0" + idProducto.charAt(1) + idProducto.charAt(2);
                        }

                        Producto producto = productos.get(idProducto);
                        if (producto != null) {
                            double dineroRecibido = producto.getPrecio() * cantidadVendida;
                            vendedor.agregarVenta(dineroRecibido);
                            System.out.println("Venta procesada para " + vendedor.getNombre() + ": " + producto.getNombre() + " x " + cantidadVendida + " = " + dineroRecibido);
                        } else {
                            System.out.println("Producto no encontrado para la venta: " + idProducto);
                        }
                    }
                } else {
                    System.out.println("Formato incorrecto en la primera línea del archivo de ventas.");
                }
            }
        }
    }

    // Genera un archivo CSV con los datos de ventas por vendedor
    public static void generarReporteCSV(Map<String, Vendedor> vendedores, String nombreArchivo) throws IOException {
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(nombreArchivo))) {
            // Cabecera del archivo CSV
            writer.write("Tipo Documento, Número Documento, Nombre, Apellido, Total Vendido\n");

            // Escribe una línea por cada vendedor
            for (Vendedor vendedor : vendedores.values()) {
                writer.write(vendedor.getTipoDocumento() + ", " +
                             vendedor.getNumeroDocumento() + ", " +
                             vendedor.getNombre() + ", " +
                             vendedor.getApellido() + ", " +
                             vendedor.getTotalVentas() + "\n");
            }

            System.out.println("Reporte CSV generado exitosamente.");
        }
    }
}
