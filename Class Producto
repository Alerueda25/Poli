// Declara que esta clase pertenece al paquete "aleja"
package aleja;

// Se define una clase pública llamada Producto
public class Producto {

    // Atributos privados de la clase: ID, nombre y precio del producto
    private String id;
    private String nombre;
    private double precio;

    // Constructor: se ejecuta al crear un nuevo objeto Producto
    // Recibe el ID, el nombre y el precio como parámetros
    public Producto(String id, String nombre, double precio) {
        this.id = id;               // Asigna el ID al atributo de la clase
        this.nombre = nombre;       // Asigna el nombre al atributo de la clase
        this.precio = precio;       // Asigna el precio al atributo de la clase
    }

    // Método público que devuelve el nombre del producto
    public String getNombre() {
        return nombre;
    }

    // Método público que devuelve el precio del producto
    public double getPrecio() {
        return precio;
    }

    // Método público que devuelve el ID del producto
    public String getId() {
        return id;
    }

    // Sobrescribe el método toString para representar el objeto como texto
    // Esto es útil para imprimir el objeto con información legible
    @Override
    public String toString() {
        return "Producto{" +
               "id='" + id + '\'' +         // Muestra el ID del producto
               ", nombre='" + nombre + '\'' + // Muestra el nombre del producto
               ", precio=" + precio +         // Muestra el precio del producto
               '}';                           // Cierra el formato del texto
    }
}
