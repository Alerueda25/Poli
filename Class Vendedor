// Indica que esta clase pertenece al paquete "aleja"
package aleja;

// Se declara la clase pública Vendedor
public class Vendedor {

    // Atributos privados del vendedor: tipo y número de documento, nombre, apellido y total de ventas
    private String tipoDocumento;
    private String numeroDocumento;
    private String nombre;
    private String apellido;
    private double totalVentas;

    // Constructor: se ejecuta al crear un objeto de tipo Vendedor
    // Recibe tipoDocumento, numeroDocumento, nombre y apellido como parámetros
    public Vendedor(String tipoDocumento, String numeroDocumento, String nombre, String apellido) {
        this.tipoDocumento = tipoDocumento;       // Asigna el tipo de documento
        this.numeroDocumento = numeroDocumento;   // Asigna el número de documento
        this.nombre = nombre;                     // Asigna el nombre
        this.apellido = apellido;                 // Asigna el apellido
        this.totalVentas = 0.0;                   // Inicializa las ventas en 0.0
    }

    // Método que suma una venta al total del vendedor
    // Recibe el valor de la venta como parámetro
    public void agregarVenta(double valor) {
        totalVentas += valor; // Suma el valor recibido al total de ventas
    }

    // Métodos 'getter' para acceder a los atributos privados:

    public String getTipoDocumento() {
        return tipoDocumento; // Devuelve el tipo de documento
    }

    public String getNumeroDocumento() {
        return numeroDocumento; // Devuelve el número de documento
    }

    public String getNombre() {
        return nombre; // Devuelve el nombre del vendedor
    }

    public String getApellido() {
        return apellido; // Devuelve el apellido del vendedor
    }

    public double getTotalVentas() {
        return totalVentas; // Devuelve el total de ventas acumulado
    }

    // Sobrescribe el método toString para representar el objeto como texto legible
    // Útil para imprimir la información del vendedor en consola o archivos
    @Override
    public String toString() {
        return tipoDocumento + " " + numeroDocumento + " - " + nombre + " " + apellido +
               " - Total Vendido: " + totalVentas;
    }
}
